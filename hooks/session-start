#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CONTEXT_FRESHNESS_WARNING=""
ACTIVE_CHANGE_CONTEXT=""

if command -v python3 >/dev/null 2>&1; then
    CONTEXT_FRESHNESS_WARNING="$(python3 - <<'PY' 2>/dev/null || true
import json
from datetime import datetime, timezone
from pathlib import Path

project = Path.cwd()
state_path = project / ".ai_code_copilot" / ".copilot-state.json"
config_path = project / ".ai_code_copilot" / "config.json"

try:
    state = json.loads(state_path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(0)

synced_at = state.get("projectContextSyncedAt") or state.get("lastSyncedAt")
if not synced_at:
    raise SystemExit(0)

stale_after = state.get("projectContextStaleAfterDays", 30)
try:
    config = json.loads(config_path.read_text(encoding="utf-8"))
    stale_after = config.get("projectContextStaleAfterDays", stale_after)
except Exception:
    pass

try:
    stale_after = int(stale_after)
    synced_dt = datetime.fromisoformat(str(synced_at).replace("Z", "+00:00"))
    if synced_dt.tzinfo is None:
        synced_dt = synced_dt.replace(tzinfo=timezone.utc)
except Exception:
    raise SystemExit(0)

days = (datetime.now(timezone.utc) - synced_dt.astimezone(timezone.utc)).days
if days > stale_after:
    print(
        "<context-freshness-warning>\n"
        f"project-context.md 已有 {days} 天未同步，可能无法反映最新架构、依赖或领域规则。\n"
        "建议在开始新开发前执行：init --sync 或 "
        "bash <COPILOT_HOME>/scripts/init_project.sh --project . --sync。\n"
        "这是软提醒，不阻塞当前会话；如需调整阈值，在 .ai_code_copilot/config.json 设置 projectContextStaleAfterDays。\n"
        "</context-freshness-warning>"
    )
PY
)"

    ACTIVE_CHANGE_CONTEXT="$(python3 - <<'PY' 2>/dev/null || true
from pathlib import Path

changes_dir = Path.cwd() / ".ai_code_copilot" / "changes"
if not changes_dir.is_dir():
    raise SystemExit(0)

def field_value(path, key):
    if not path.exists():
        return None
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            if line.strip().startswith(f"{key}:"):
                return line.split(":", 1)[1].strip().strip('"')
    except Exception:
        return None
    return None

def change_status(change):
    return field_value(change / "summary.md", "status") or field_value(change / "quick-card.md", "status")

def quick_front_matter(path, allowed_keys):
    if not path.exists():
        return []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except Exception:
        return []
    if not lines or lines[0].strip() != "---":
        return []
    fields = {}
    for line in lines[1:]:
        stripped = line.strip()
        if stripped == "---":
            break
        key, separator, _ = stripped.partition(":")
        if separator and key in allowed_keys and key not in fields:
            fields[key] = stripped
    return [fields[key] for key in allowed_keys if key in fields]

all_changes = sorted(
    p for p in changes_dir.iterdir()
    if p.is_dir() and p.name not in {"archives", "templates"} and not p.name.startswith(".")
)
active = [p for p in all_changes if change_status(p) != "finished"]
if not active:
    raise SystemExit(0)

if len(active) > 1:
    names = ", ".join(p.name for p in active[:12])
    suffix = " ..." if len(active) > 12 else ""
    print(
        "<active-change-context>\n"
        "检测到多个进行中变更；仅列名称，不加载 spec/log 全文。请在命令中明确变更名。\n"
        f"changes: {names}{suffix}\n"
        "</active-change-context>"
    )
    raise SystemExit(0)

change = active[0]
summary = change / "summary.md"
required_fields = ["change:", "status:", "spec-hash:", "goal:", "scope:", "open-risks:", "loaded-knowledge:"]
print("<active-change-context>")
print("检测到 1 个进行中变更；SessionStart 只注入摘要，完整 spec/tasks/test-spec 由命令阶段按需加载。")
print(f"path: .ai_code_copilot/changes/{change.name}")
if summary.exists():
    lines = [line.rstrip() for line in summary.read_text(encoding="utf-8").splitlines()]
    useful = [line for line in lines if line.strip() and not line.lstrip().startswith("<!--")]
    missing = [
        field for field in required_fields
        if not any(line.strip().startswith(field) for line in useful)
    ]
    if missing:
        print("summary-validation: invalid summary.md; missing fields: " + ", ".join(missing))
        print("fallback: 命令阶段将读取完整变更文档；请在 /propose 或 /fix 后修复 summary.md。")
    for line in useful[:8]:
        print(line)
else:
    quick_fields = [
        "change",
        "status",
        "recordMode",
        "specHash",
        "parentIssue",
        "workIssue",
        "issueRelationship",
        "branch",
    ]
    for line in quick_front_matter(change / "quick-card.md", quick_fields):
        print(line)
print("</active-change-context>")
PY
)"
fi

SAFETY_CONTENT='<ai-code-copilot-safety-rules>
你的环境中已安装 ai-code-copilot 编码协作框架。以下安全规则始终生效：

框架根目录：'"$PLUGIN_ROOT"'
兼容平台：Codex / Claude Code
完整提示词位置：'"$PLUGIN_ROOT"'/agents/copilot-prompt.md
SessionStart 注入层级：仅 L0 安全规则、框架路径、命令菜单、上下文新鲜度提醒和活跃变更摘要；不在启动时加载 pack rules、knowledge 全文或 spec.md 全文。

<HARD-GATE>
Standard/Complex 档：/propose 未完成且用户未确认前，禁止任何编码动作。
Quick 档：必须先生成 quick-card.md（目标/文件/非目标/验收/风险），用户确认后才执行。
任何档位：涉及资金/状态流转/权限变更，必须高亮提醒，等待人工确认后才能继续。
不确定档位时，默认走 Standard。
</HARD-GATE>

安全红线（始终生效）：
- 禁止在代码中硬编码密钥、AK/SK、数据库密码
- 禁止在日志中打印手机号、身份证、银行卡等敏感信息
- 涉及资金变更的逻辑必须人工审查后方可编码
- 涉及状态流转必须检查状态机合法性
- 涉及权限变更必须显式校验操作人权限

可用命令：init / brainstorm / propose / apply / fix / fix-ci / review / finish / test / archive
Codex 输入提示：请直接说 finish <变更名>、archive <变更名> 或中文自然语言；不要输入 /archive，Codex 会把它当成“归档当前会话”。若 /finish 被客户端拦截，也改用 finish <变更名>。
如需完整框架能力，请说"帮我实现..."或直接调用命令名触发 ai-code-copilot skill。

'"$CONTEXT_FRESHNESS_WARNING"'
'"$ACTIVE_CHANGE_CONTEXT"'
</ai-code-copilot-safety-rules>'

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$SAFETY_CONTENT")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
