#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

SAFETY_CONTENT='<ai-code-copilot-safety-rules>
你的环境中已安装 ai-code-copilot 编码协作框架。以下安全规则始终生效：

框架根目录：'"$PLUGIN_ROOT"'
兼容平台：Codex / Claude Code
完整提示词位置：'"$PLUGIN_ROOT"'/agents/copilot-prompt.md

<HARD-GATE>
Standard/Complex 档：/propose 未完成且用户未确认前，禁止任何编码动作。
Quick 档：必须先生成 quick-card.md（目标/文件/非目标/验收/风险），用户确认后才执行。
任何档位：涉及资金/状态流转/权限变更，必须高亮提醒，等待人工确认后才能继续。
不确定档位时，默认走 Standard。
</HARD-GATE>

安全红线（始终生效）：
- 禁止在代码中硬编码密钥、AK/SK、数据库密码
- 禁止在日志中打印手机号、身份证、银行卡等敏感信息
- 涉及资金变更的逻辑必须人工审查后方可编码
- 涉及状态流转必须检查状态机合法性
- 涉及权限变更必须显式校验操作人权限

可用命令：init / brainstorm / propose / apply / fix / fix-ci / review / finish / test / archive
如需完整框架能力，请说"帮我实现..."或直接调用命令名触发 ai-code-copilot skill。
</ai-code-copilot-safety-rules>'

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$SAFETY_CONTENT")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
