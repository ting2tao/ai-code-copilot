#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CONTEXT_FRESHNESS_WARNING=""
ACTIVE_CHANGE_CONTEXT=""

if command -v python3 >/dev/null 2>&1; then
    CONTEXT_FRESHNESS_WARNING="$(python3 - <<'PY' 2>/dev/null || true
import json
from datetime import datetime, timezone
from pathlib import Path

project = Path.cwd()
state_path = project / ".ai_code_copilot" / ".copilot-state.json"
config_path = project / ".ai_code_copilot" / "config.json"

try:
    state = json.loads(state_path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(0)

synced_at = state.get("projectContextSyncedAt") or state.get("lastSyncedAt")
if not synced_at:
    raise SystemExit(0)

stale_after = state.get("projectContextStaleAfterDays", 30)
try:
    config = json.loads(config_path.read_text(encoding="utf-8"))
    stale_after = config.get("projectContextStaleAfterDays", stale_after)
except Exception:
    pass

try:
    stale_after = int(stale_after)
    synced_dt = datetime.fromisoformat(str(synced_at).replace("Z", "+00:00"))
    if synced_dt.tzinfo is None:
        synced_dt = synced_dt.replace(tzinfo=timezone.utc)
except Exception:
    raise SystemExit(0)

days = (datetime.now(timezone.utc) - synced_dt.astimezone(timezone.utc)).days
if days > stale_after:
    print(
        "<context-freshness-warning>\n"
        f"project-context.md 已有 {days} 天未同步，可能无法反映最新架构、依赖或领域规则。\n"
        "建议在开始新开发前执行：init --sync 或 "
        "bash <COPILOT_HOME>/scripts/init_project.sh --project . --sync。\n"
        "这是软提醒，不阻塞当前会话；如需调整阈值，在 .ai_code_copilot/config.json 设置 projectContextStaleAfterDays。\n"
        "</context-freshness-warning>"
    )
PY
)"

    ACTIVE_CHANGE_CONTEXT="$(python3 - <<'PY' 2>/dev/null || true
import ast
import json
import re
import unicodedata
from pathlib import Path

changes_dir = Path.cwd() / ".ai_code_copilot" / "changes"
if not changes_dir.is_dir():
    raise SystemExit(0)

def summary_metadata(path):
    if not path.exists():
        return None
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return None
    fields = []
    seen_keys = set()
    metadata_started = False
    in_leading_comment = False
    for line in lines:
        stripped = line.strip()
        if not metadata_started:
            if in_leading_comment:
                if "-->" in stripped:
                    in_leading_comment = False
                continue
            if not stripped:
                continue
            if stripped.startswith("<!--"):
                in_leading_comment = "-->" not in stripped
                continue
        elif not stripped or stripped.startswith(("#", "<!--")):
            break
        key, separator, raw_value = stripped.partition(":")
        if (
            not separator
            or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,63}", key)
        ):
            break
        if not raw_value.strip():
            return None
        if key in seen_keys:
            return None
        normalized = summary_scalar_value(raw_value.strip())
        if normalized is None:
            return None
        fields.append((key, normalized))
        seen_keys.add(key)
        metadata_started = True
    status_values = [value for key, value in fields if key == "status"]
    if status_values and not re.fullmatch(r"[a-z][a-z0-9-]*", status_values[0]):
        return None
    return fields if fields else None

def has_control_characters(value):
    return any(unicodedata.category(character).startswith("C") for character in value)

def scalar_value(raw_value):
    if not raw_value or len(raw_value) > 256 or has_control_characters(raw_value):
        return None
    if raw_value[0] in {'"', "'"}:
        quote = raw_value[0]
        escaped = False
        closing = None
        for index, character in enumerate(raw_value[1:], start=1):
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == quote:
                closing = index
                break
        if closing is None:
            return None
        token = raw_value[:closing + 1]
        suffix = raw_value[closing + 1:].strip()
        if suffix and not suffix.startswith("#"):
            return None
        try:
            value = json.loads(token) if quote == '"' else ast.literal_eval(token)
        except (ValueError, SyntaxError):
            return None
        if not isinstance(value, str) or not value or len(value) > 256 or has_control_characters(value):
            return None
        return value
    value = re.split(r"\s+#", raw_value, maxsplit=1)[0].strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/@+\-]*", value):
        return None
    return value

def summary_scalar_value(raw_value):
    if not raw_value or len(raw_value) > 512 or has_control_characters(raw_value):
        return None
    if raw_value[0] in {'"', "'"}:
        quote = raw_value[0]
        escaped = False
        closing = None
        for index, character in enumerate(raw_value[1:], start=1):
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == quote:
                closing = index
                break
        if closing is None:
            return None
        token = raw_value[:closing + 1]
        suffix = raw_value[closing + 1:].strip()
        if suffix and not suffix.startswith("#"):
            return None
        try:
            value = json.loads(token) if quote == '"' else ast.literal_eval(token)
        except (ValueError, SyntaxError):
            return None
    else:
        value = re.split(r"\s+#(?!\d)", raw_value, maxsplit=1)[0].strip()
    if not value or len(value) > 512 or has_control_characters(value):
        return None
    return value

def quick_front_matter(path):
    if not path.exists():
        return None
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return None
    if not lines or lines[0].strip() != "---":
        return None
    fields = {}
    closed = False
    for line in lines[1:]:
        stripped = line.strip()
        if stripped == "---":
            closed = True
            break
        if not stripped or stripped.startswith("#"):
            continue
        key, separator, raw_value = stripped.partition(":")
        if (
            not separator
            or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,63}", key)
            or key in fields
        ):
            return None
        normalized = scalar_value(raw_value.strip())
        if normalized is None:
            return None
        fields[key] = normalized
    return fields if closed else None

def canonical_metadata_line(key, value):
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/@+\-]*", value):
        rendered = value
    else:
        rendered = json.dumps(value, ensure_ascii=False)
        rendered = rendered.replace("&", "\\u0026").replace("<", "\\u003c").replace(">", "\\u003e")
    return f"{key}: {rendered}"

def change_status(change):
    summary = change / "summary.md"
    if summary.exists():
        metadata = summary_metadata(summary)
        if metadata is None:
            return None
        return next((value for key, value in metadata if key == "status"), None)
    fields = quick_front_matter(change / "quick-card.md")
    return fields.get("status") if fields is not None else None

all_changes = sorted(
    p for p in changes_dir.iterdir()
    if p.is_dir() and p.name not in {"archives", "templates"} and not p.name.startswith(".")
)
active = [p for p in all_changes if change_status(p) != "finished"]
if not active:
    raise SystemExit(0)

if len(active) > 1:
    names = ", ".join(p.name for p in active[:12])
    suffix = " ..." if len(active) > 12 else ""
    print(
        "<active-change-context>\n"
        "检测到多个进行中变更；仅列名称，不加载 spec/log 全文。请在命令中明确变更名。\n"
        f"{canonical_metadata_line('changes', names + suffix)}\n"
        "</active-change-context>"
    )
    raise SystemExit(0)

change = active[0]
summary = change / "summary.md"
required_fields = ["change:", "status:", "spec-hash:", "goal:", "scope:", "open-risks:", "loaded-knowledge:"]
print("<active-change-context>")
print("检测到 1 个进行中变更；SessionStart 只注入摘要，完整 spec/tasks/test-spec 由命令阶段按需加载。")
print(canonical_metadata_line("path", f".ai_code_copilot/changes/{change.name}"))
if summary.exists():
    metadata = summary_metadata(summary)
    if metadata is None:
        print("summary-validation: invalid summary metadata; content omitted.")
    else:
        present_keys = {key for key, _ in metadata}
        missing = [field for field in required_fields if field[:-1] not in present_keys]
        if missing:
            print("summary-validation: invalid summary.md; missing fields: " + ", ".join(missing))
            print("fallback: 命令阶段将读取完整变更文档；请在 /propose 或 /fix 后修复 summary.md。")
        for key, value in metadata[:8]:
            print(canonical_metadata_line(key, value))
else:
    quick_card = change / "quick-card.md"
    quick_fields = [
        "change",
        "status",
        "recordMode",
        "specHash",
        "parentIssue",
        "workIssue",
        "issueRelationship",
        "branch",
    ]
    quick_metadata = quick_front_matter(quick_card)
    if quick_metadata is None:
        if quick_card.exists():
            print("quick-card-validation: invalid quick-card metadata; content omitted.")
        else:
            print("quick-card-validation: missing quick-card.md; metadata omitted.")
    else:
        for key in quick_fields:
            if key in quick_metadata:
                print(canonical_metadata_line(key, quick_metadata[key]))
print("</active-change-context>")
PY
)"
fi

SAFETY_CONTENT='<ai-code-copilot-safety-rules>
你的环境中已安装 ai-code-copilot 编码协作框架。以下安全规则始终生效：

框架根目录：'"$PLUGIN_ROOT"'
兼容平台：Codex / Claude Code
轻量路由位置：'"$PLUGIN_ROOT"'/agents/router.md
按需模块目录：'"$PLUGIN_ROOT"'/agents/workflows/
Legacy fallback：'"$PLUGIN_ROOT"'/agents/copilot-prompt.md
SessionStart 注入层级：仅 L0 安全规则、框架路径、命令菜单、上下文新鲜度提醒和活跃变更摘要；不在启动时加载 pack rules、knowledge 全文或 spec.md 全文。

<HARD-GATE>
Inline SDD 仅在全部低风险条件明确满足且 Goal/Scope/Done Signal/Verify 可见时允许编辑。
Compact SDD 必须有有效 quick-card.md；Full SDD 必须有已确认 Spec。
涉及资金/状态流转/权限/安全/生产风险必须进入 Full 并等待人工确认。
不确定时使用 Compact；活动变更只允许 Inline -> Compact -> Full 或 Inline -> Full，不自动降级。
</HARD-GATE>

安全红线（始终生效）：
- 禁止在代码中硬编码密钥、AK/SK、数据库密码
- 禁止在日志中打印手机号、身份证、银行卡等敏感信息
- 涉及资金变更的逻辑必须人工审查后方可编码
- 涉及状态流转必须检查状态机合法性
- 涉及权限变更必须显式校验操作人权限

可用命令：init / brainstorm / propose / apply / fix / fix-ci / review / finish / test / archive
Codex 输入提示：请直接说 finish <变更名>、archive <变更名> 或中文自然语言；不要输入 /archive，Codex 会把它当成“归档当前会话”。若 /finish 被客户端拦截，也改用 finish <变更名>。
如需完整框架能力，请说"帮我实现..."或直接调用命令名触发 ai-code-copilot skill。

'"$CONTEXT_FRESHNESS_WARNING"'
'"$ACTIVE_CHANGE_CONTEXT"'
</ai-code-copilot-safety-rules>'

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$SAFETY_CONTENT")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
