{
  "projectContextStaleAfterDays": 30,
  "logCompression": {
    "reviewThresholdLines": 150,
    "fixThresholdLines": 200
  },
  "githubWorkflow": {
    "issuePolicy": "on-publish",
    "finishMode": "ask",
    "createPrAfterReviewPass": false,
    "defaultBaseBranch": "main",
    "pushRemote": "origin",
    "prDraft": false
  }
}
